# then unset it for normal local processing. Audio/transcripts are never download inputs.
# WHISPER_MEETING_ALLOW_MODEL_DOWNLOADS=1
# ENHANCEMENT_PYTHON=$HOME/whisper-ru/enhancement-venv/bin/python
